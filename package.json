{
  "name": "katechon-demo",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build-vercel.js && node scripts/check-vercel-output.js",
    "brand:logo-gif": "node scripts/generate-logo-gif.js",
    "brand:share-cards": "node scripts/generate-share-cards.js",
    "launch:smoke": "node scripts/launch-smoke.js",
    "launch:e2e": "node scripts/launch-e2e.js",
    "launch:visual": "node scripts/launch-visual.js",
    "launch:qa": "node scripts/launch-qa.js",
    "start": "node server.js",
    "dev": "node server.js",
    "dune:audio": "public/decks/dune/scripts/generate-elevenlabs-narration.sh",
    "dune:visuals": "python3 public/decks/dune/scripts/generate-replicate-visuals.py",
    "dune:voiceover": "node public/decks/dune/scripts/write-voiceover-script.js",
    "pitch:dev": "npm --prefix ../katechon-pitch run dev -- --host 127.0.0.1 --port 5174 --strictPort"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "form-data": "^4.0.5",
    "node-fetch": "^2.7.0"
  }
}
