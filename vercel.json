{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/whitepaper",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/whitepaper/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/share/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    },
    {
      "source": "/app/share/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    },
    {
      "source": "/share-thumbnails/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    },
    {
      "source": "/app/share-thumbnails/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/share/:dashboard/",
      "destination": "/share/:dashboard",
      "permanent": false
    },
    {
      "source": "/app/share/:dashboard/",
      "destination": "/app/share/:dashboard",
      "permanent": false
    },
    {
      "source": "/whitepaper/katechon-whitepaper.pdf",
      "destination": "/whitepaper",
      "permanent": false,
      "missing": [
        {
          "type": "cookie",
          "key": "katechon_whitepaper",
          "value": "whitepaper-open"
        }
      ]
    },
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/deck",
      "destination": "/deck/index.html"
    },
    {
      "source": "/deck/",
      "destination": "/deck/index.html"
    },
    {
      "source": "/app/deck",
      "destination": "/app/deck/index.html"
    },
    {
      "source": "/app/deck/",
      "destination": "/app/deck/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "http://176.57.184.142:4040/api/:path*"
    },
    {
      "source": "/stream.m3u8",
      "destination": "http://176.57.184.142:4040/stream.m3u8"
    },
    {
      "source": "/:segment(seg[0-9]+\\.ts)",
      "destination": "http://176.57.184.142:4040/:segment"
    },
    {
      "source": "/dashboards/identities/:path*",
      "destination": "/dashboards/identities/:path*"
    },
    {
      "source": "/app/api/:path*",
      "destination": "http://176.57.184.142:4040/api/:path*"
    },
    {
      "source": "/app/stream.m3u8",
      "destination": "http://176.57.184.142:4040/stream.m3u8"
    },
    {
      "source": "/app/:segment(seg[0-9]+\\.ts)",
      "destination": "http://176.57.184.142:4040/:segment"
    },
    {
      "source": "/app/dashboards/identities/:path*",
      "destination": "/app/dashboards/identities/:path*"
    },
    {
      "source": "/app/",
      "destination": "/app/index.html"
    }
  ]
}
